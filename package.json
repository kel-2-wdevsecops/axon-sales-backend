{
  "name": "axon_sales_backend",
  "version": "1.1.0",
  "description": "REST API untuk data penjualan Axon (database classicmodels).",
  "keywords": [
    "sales",
    "classicmodels",
    "api"
  ],
  "license": "ISC",
  "author": "Kelompok 2 DevSecOps",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "vitest run --dir src",
    "start": "node dist/server.js",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "lint": "eslint src test --max-warnings 0",
    "format": "prettier --write src",
    "prepare": "husky || exit 0",
    "test:golden": "vitest run --dir test/golden",
    "test:empty": "vitest run --dir test/empty"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "mariadb": "3.4.7"
  }
}
