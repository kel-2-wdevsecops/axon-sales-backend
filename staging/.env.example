# Salin ke /opt/axon-staging/.env di VPS, lalu `chmod 600 .env`.
# JANGAN commit .env. BE_IMAGE dan FE_IMAGE ditulis axon-staging.sh, jangan
# diisi manual.

# openssl rand -hex 24  (keduanya HARUS heksadesimal, lihat initdb/20-app-user.sh)
MARIADB_ROOT_PASSWORD=
APP_DB_PASSWORD=

# Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels -> token). Kosongkan
# COMPOSE_PROFILES kalau tidak memakai tunnel, dan BEHIND_CLOUDFLARE=false.
COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=
BEHIND_CLOUDFLARE=true
