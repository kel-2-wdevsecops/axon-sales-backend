# MariaDB hemat memori untuk VPS staging 1 GB. Default MariaDB 11 memakai
# buffer pool 128 MB dan performance_schema; data classicmodels hanya
# beberapa MB, jadi semua itu terbuang percuma di sini.
[mariadb]
performance_schema      = OFF
innodb_buffer_pool_size = 64M
innodb_log_buffer_size  = 4M
innodb_log_file_size    = 32M
key_buffer_size         = 1M
max_connections         = 20
thread_cache_size       = 4
table_open_cache        = 200
table_definition_cache  = 200
tmp_table_size          = 8M
max_heap_table_size     = 8M
skip-name-resolve
